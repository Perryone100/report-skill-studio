{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://report-skill-studio.local/schemas/default-weekly-meeting/0.2.1",
  "title": "Generic weekly meeting report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "meeting_date",
    "executive_summary",
    "summary_cards",
    "sections"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "meeting_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "summary_cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/summaryCard" }
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/overallConclusionSection" },
        { "$ref": "#/$defs/thisWeekProgressSection" },
        { "$ref": "#/$defs/nextWeekPlanSection" },
        { "$ref": "#/$defs/risksAndCoordinationSection" }
      ],
      "items": false
    }
  },
  "$defs": {
    "tone": {
      "type": "string",
      "enum": ["neutral", "info", "success", "warning", "danger"]
    },
    "summaryCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "value": { "type": "string", "minLength": 1, "maxLength": 240 },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "bulletList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "bullet_list" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "workProgressTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns", "rows"],
      "properties": {
        "type": { "const": "project_table" },
        "columns": {
          "const": ["工作项", "本周进展", "当前状态", "下一步"]
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "callout" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "overallConclusionSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "blocks"],
      "properties": {
        "id": { "const": "overall_conclusion" },
        "title": { "const": "本周整体结论" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "$ref": "#/$defs/paragraph" }],
          "items": false
        }
      }
    },
    "thisWeekProgressSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "blocks"],
      "properties": {
        "id": { "const": "this_week_progress" },
        "title": { "const": "本周工作进展" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "$ref": "#/$defs/workProgressTable" }],
          "items": false
        }
      }
    },
    "nextWeekPlanSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "blocks"],
      "properties": {
        "id": { "const": "next_week_plan" },
        "title": { "const": "下周重点计划" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "$ref": "#/$defs/bulletList" }],
          "items": false
        }
      }
    },
    "risksAndCoordinationSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "blocks"],
      "properties": {
        "id": { "const": "risks_and_coordination" },
        "title": { "const": "风险与待协调事项" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/bulletList" },
              { "$ref": "#/$defs/callout" }
            ]
          }
        }
      }
    }
  }
}
