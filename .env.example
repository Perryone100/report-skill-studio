# Report Skill Studio reads RSS_* values from the process environment or a
# repository-root .env file. Copy this file to .env for local development.

# Local storage. Relative paths are resolved from the process working directory.
RSS_DATA_DIR=./data
RSS_SKILLS_DIR=./skills
# Initial Markdown project library. The path saved from the Settings dialog
# takes precedence after the user configures it once.
# RSS_PROJECTS_DIR=/Users/your-name/Documents/Report Skill Studio

# The Vite development server currently listens on port 4173.
RSS_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Optional OpenAI-compatible provider. Keep these blank to use only the local
# deterministic mock provider. Never put a real credential in this example.
# Multiple independently authenticated connections. Keep this as a one-line JSON
# array in your local .env; each item has id, name, base_url, api_key and models.
RSS_OPENAI_COMPATIBLE_CONNECTIONS=[]
# Legacy single-connection settings remain supported and may be used together
# with the multi-connection array.
RSS_OPENAI_COMPATIBLE_BASE_URL=
RSS_OPENAI_COMPATIBLE_API_KEY=
# Comma-separated model ids. Each model becomes an independent dropdown option.
RSS_OPENAI_COMPATIBLE_MODELS=
# Backward-compatible single-model setting. Used when MODELS is blank.
RSS_OPENAI_COMPATIBLE_MODEL=

# Web client. Vite is configured to read these from the repository-root .env.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_USE_MOCK_API=false

# Optional launcher behavior. Set only in the shell when browser auto-open is unwanted.
# RSS_NO_OPEN=true
